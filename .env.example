SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# TURNSTILE_SECRET and TURNSTILE_HOSTNAMES belong in Supabase Edge Function secrets.
# Production hostnames: www.slimplay.app,slimplay.app

# Segredos do Asaas ficam nas Edge Functions do Supabase, não neste arquivo:
# ASAAS_API_KEY
# ASAAS_WEBHOOK_TOKEN
# ASAAS_SANDBOX=false
# Webhook: https://YOUR_PROJECT.supabase.co/functions/v1/asaas-webhook
# Header do webhook: asaas-access-token
# Planos: atualize activation_plans.price_cents e active = true
